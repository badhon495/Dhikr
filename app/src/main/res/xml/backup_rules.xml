<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy Auto Backup rules (Android 11 and below). The Room database holds only
  seeded/derived data and its schema evolves without migrations, so a restored
  copy from an older app version cannot be opened. Exclude it; back up only the
  user's real preferences.

  ai_secrets is EncryptedSharedPreferences: its ciphertext is wrapped by a
  hardware-backed key that never leaves the origin device, so a restored copy
  is undecryptable and only serves to break the key store on the new device.

  drive_sync_secrets (DriveTokenStore) is the same kind of
  EncryptedSharedPreferences as ai_secrets, for the same reason: a restored
  copy is undecryptable on a new device/keystore and only serves to break the
  key store. Exclude it too.

  The "preferences" DataStore holds has_seen_onboarding, which must stay
  per-device (see AppPreferencesRepository) — otherwise a restore on a fresh
  install skips onboarding entirely. Exclude it too.

  The "drive_sync" DataStore (DriveFileIdStore / DriveAuthManager's signed-in
  account) is also per-device state: a restored copy on a new device/account
  would show a stale "Signed in as X" with no real Credential Manager
  session, and a cached Drive file id that likely belongs to a different
  device's session. Exclude it too.
-->
<full-backup-content>
    <exclude domain="database" path="dhikr.db" />
    <exclude domain="database" path="dhikr.db-shm" />
    <exclude domain="database" path="dhikr.db-wal" />
    <exclude domain="sharedpref" path="ai_secrets.xml" />
    <exclude domain="sharedpref" path="drive_sync_secrets.xml" />
    <exclude domain="file" path="datastore/preferences.preferences_pb" />
    <exclude domain="file" path="datastore/drive_sync.preferences_pb" />
</full-backup-content>
