<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup / device-transfer rules (Android 12+). The Room database is
  seeded/derived data on a migration-less schema, so a copy restored from an
  older app version cannot be opened. Exclude it from both cloud backup and
  device-to-device transfer.

  ai_secrets is EncryptedSharedPreferences: its ciphertext is wrapped by a
  hardware-backed key that never leaves the origin device, so a restored copy
  is undecryptable and only serves to break the key store on the new device.

  The "preferences" DataStore holds has_seen_onboarding, which must stay
  per-device (see AppPreferencesRepository) — otherwise a restore on a fresh
  install (Play Store install on a device/account with a prior backup) skips
  onboarding entirely. Exclude it too.
  Cloud sync (sync_secrets, sync_state, sync/) is per-device: tokens are keystore-wrapped
  like ai_secrets, and the base/snapshot files must match this device's own database.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="dhikr.db" />
        <exclude domain="database" path="dhikr.db-shm" />
        <exclude domain="database" path="dhikr.db-wal" />
        <exclude domain="sharedpref" path="ai_secrets.xml" />
        <exclude domain="sharedpref" path="sync_secrets.xml" />
        <exclude domain="sharedpref" path="sync_state.xml" />
        <exclude domain="file" path="sync/" />
        <exclude domain="file" path="datastore/preferences.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="dhikr.db" />
        <exclude domain="database" path="dhikr.db-shm" />
        <exclude domain="database" path="dhikr.db-wal" />
        <exclude domain="sharedpref" path="ai_secrets.xml" />
        <exclude domain="sharedpref" path="sync_secrets.xml" />
        <exclude domain="sharedpref" path="sync_state.xml" />
        <exclude domain="file" path="sync/" />
        <exclude domain="file" path="datastore/preferences.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
